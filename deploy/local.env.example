# Copy to deploy/local.env (git-ignored) and fill in.
PI=pi@192.168.1.50                 # ssh login for the machine that serves the dashboard
URL=http://192.168.1.50:9380       # where the dashboard answers
IMPORT_FROM=192.168.1.20           # IP of the machine that runs ingest (allowed to upload)
TITLE="Our Health"                 # shown at the top of the page
OTHERS=""                          # other dashboards (deploy/add-person.sh adds them): name:port
