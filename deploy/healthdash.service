[Unit]
Description=Health records dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=healthdash
WorkingDirectory=/opt/healthdash
# the package lives at /opt/healthdash/healthdash/
Environment=PYTHONPATH=/opt/healthdash
# install.sh fills in __IMPORT_FROM__ and __TITLE__ from deploy/local.env
ExecStart=/usr/bin/python3 -m healthdash serve --db /var/lib/healthdash/health.db --files /var/lib/healthdash/files --port 9380 --import-from __IMPORT_FROM__ --title "__TITLE__"
StateDirectory=healthdash
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
