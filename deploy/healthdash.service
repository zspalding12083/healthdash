[Unit]
Description=Health records dashboard (__STATE__)
After=network-online.target
Wants=network-online.target

[Service]
User=healthdash
WorkingDirectory=/opt/healthdash
# the package lives at /opt/healthdash/healthdash/
Environment=PYTHONPATH=/opt/healthdash
# deploy/unit.py fills in __STATE__, __PORT__, __IMPORT_FROM__ and __TITLE__
ExecStart=/usr/bin/python3 -m healthdash serve --db /var/lib/__STATE__/health.db --files /var/lib/__STATE__/files --port __PORT__ --import-from __IMPORT_FROM__ --title "__TITLE__"
StateDirectory=__STATE__
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
